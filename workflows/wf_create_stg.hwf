<?xml version="1.0" encoding="UTF-8"?>
<workflow>
  <name>wf_create_stg</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Diseño: Reset H2 mem → Python STG DDL → Success (deja H2 vivo para mapear pipelines)</description>
  <extended_description/>
  <workflow_version/>
  <created_user>-</created_user>
  <created_date>2026/08/18 11:52:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/08/18 11:52:00.000</modified_date>
  <parameters>
    </parameters>
  <actions>
    <action>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <DayOfMonth>1</DayOfMonth>
      <doNotWaitOnFirstExecution>N</doNotWaitOnFirstExecution>
      <hour>12</hour>
      <intervalMinutes>60</intervalMinutes>
      <intervalSeconds>0</intervalSeconds>
      <minutes>0</minutes>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <weekDay>1</weekDay>
      <parallel>N</parallel>
      <xloc>48</xloc>
      <yloc>192</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Reset H2 clean</name>
      <description>stop + start H2 mem + DDL (00_reset.sql + 01_schema.sql)</description>
      <type>SHELL</type>
      <attributes/>
      <filename/>
      <work_directory>${PROJECT_HOME}</work_directory>
      <arg_from_previous>N</arg_from_previous>
      <exec_per_row>N</exec_per_row>
      <set_logfile>N</set_logfile>
      <logfile/>
      <set_append_logfile>N</set_append_logfile>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <insertScript>Y</insertScript>
      <script>set -e
cd "${PROJECT_HOME}"
./h2/scripts/reset_and_create.sh
</script>
      <loglevel>Basic</loglevel>
      <parallel>N</parallel>
      <xloc>208</xloc>
      <yloc>192</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Python create STG</name>
      <description>inputs.yaml → introspect fuentes → CREATE TABLE STG_* en H2 (no extrae filas)</description>
      <type>SHELL</type>
      <attributes/>
      <filename/>
      <work_directory>${PROJECT_HOME}</work_directory>
      <arg_from_previous>N</arg_from_previous>
      <exec_per_row>N</exec_per_row>
      <set_logfile>N</set_logfile>
      <logfile/>
      <set_append_logfile>N</set_append_logfile>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <insertScript>Y</insertScript>
      <script>set -e
cd "${PROJECT_HOME}"
PY=python3
[ -x .venv/bin/python ] &amp;&amp; PY=.venv/bin/python
"$PY" python/create_stg.py
</script>
      <loglevel>Basic</loglevel>
      <parallel>N</parallel>
      <xloc>384</xloc>
      <yloc>192</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Success</name>
      <description>H2 queda vivo en 9092 con STG_* (si inputs.yaml tiene sources)</description>
      <type>SUCCESS</type>
      <attributes/>
      <parallel>N</parallel>
      <xloc>560</xloc>
      <yloc>192</yloc>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Reset H2 clean</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>Reset H2 clean</from>
      <to>Python create STG</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Python create STG</from>
      <to>Success</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
  <notepads>
    <notepad>
      <backgroundcolorblue>251</backgroundcolorblue>
      <backgroundcolorgreen>232</backgroundcolorgreen>
      <backgroundcolorred>201</backgroundcolorred>
      <bordercolorblue>90</bordercolorblue>
      <bordercolorgreen>58</bordercolorgreen>
      <bordercolorred>14</bordercolorred>
      <fontbold>N</fontbold>
      <fontcolorblue>90</fontcolorblue>
      <fontcolorgreen>58</fontcolorgreen>
      <fontcolorred>14</fontcolorred>
      <fontitalic>N</fontitalic>
      <fontname>Segoe UI</fontname>
      <fontsize>11</fontsize>
      <height>110</height>
      <xloc>48</xloc>
      <yloc>32</yloc>
      <note>DISEÑO (no extrae filas). Play este workflow primero.
1) Completa inputs.yaml
2) Play wf_create_stg: Reset H2 + Python CREATE TABLE STG_*
3) H2 queda vivo (puerto 9092). En el GUI mapea TableOutput a STG_*.
4) Corrida diaria: wf_main (Python recrea STG porque H2 in-memory se borra en el reset).
sources: [] = no-op (solo DEMO_TABLA_EJEMPLO). Si paras el server H2, las STG se pierden.</note>
      <width>720</width>
    </notepad>
  </notepads>
  <attributes/>
</workflow>
