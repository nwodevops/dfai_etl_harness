<?xml version="1.0" encoding="UTF-8"?>
<workflow>
   <name>wf_main_windows</name>
   <name_sync_with_filename>Y</name_sync_with_filename>
   <description>Corrida DFAI Windows: Reset H2 → create STG → Sheets a H2 → Python a Oracle</description>
   <extended_description/>
