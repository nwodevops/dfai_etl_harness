         <add_time>N</add_time>
         <insertScript>Y</insertScript>
         <script>cd /d "%PROJECT_HOME%"
call scripts\step_create_stg.bat
if errorlevel 1 exit /b 1
</script>
         <xloc>368</xloc>
         <yloc>192</yloc>
